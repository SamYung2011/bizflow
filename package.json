{
  "name": "bizflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:shell": "node scripts/build-shell-bundle.mjs",
    "build:root-site": "node scripts/build-root-site.mjs --outdir dist",
    "check:shell": "node scripts/build-shell-bundle.mjs --check",
    "test:quick": "node scripts/test-data-phase1.mjs && node scripts/test-data-phase1-runtime.mjs && npm run check:shell",
    "test:pg": "node scripts/test-data-phase1-pg.mjs && node scripts/test-team-task-page-pg.mjs",
    "build": "npm run build:shell && node scripts/build-front-door.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/query-sync-storage-persister": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "0.21.5",
    "vite": "^5.1.0"
  }
}
